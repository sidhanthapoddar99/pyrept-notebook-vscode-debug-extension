{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch",
            "type": "shell",
            "command": "bun run watch",
            "options": { "cwd": "${workspaceFolder}/extension" },
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": { "reveal": "never" },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "compile",
            "type": "shell",
            "command": "bun run compile",
            "options": { "cwd": "${workspaceFolder}/extension" },
            "problemMatcher": "$tsc",
            "group": "build"
        }
    ]
}
